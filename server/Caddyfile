{
	# Bind to the address configured in /etc/jargle/jargle.env.
	default_bind {$JARGLE_BIND_IP}
}

(jargle_site) {
	root * /var/www/jargle/current
	encode zstd gzip
	# Relative target so it also works under a tunnel path.
	redir /downloads downloads/ 308

	@nocache path / /index.html /sw.js /manifest.webmanifest /healthz.txt /content/*
	@hashed path /assets/*
	@content path /content/*
	@contentOptions {
		method OPTIONS
		path /content/*
	}

	# A CSP would be too easy to break the app, so it is intentionally omitted.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	header @nocache Cache-Control "no-cache"
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @content Access-Control-Allow-Origin "*"

	handle_path /downloads/* {
		root * /var/www/jargle/downloads
		header Cache-Control "no-cache"
		file_server browse
	}

	handle @contentOptions {
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		header Access-Control-Allow-Headers "*"
		respond "" 204
	}

	# Static asset paths must return 404 instead of the SPA shell when missing.
	handle @hashed {
		file_server
	}
	handle @content {
		file_server
	}

	# Everything else falls back to the app shell, which must never be cached long.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Error pages must not keep the year-long asset cache header.
	handle_errors {
		header Cache-Control "no-store"
		header -Server
		respond "{err.status_code} {err.status_text}"
	}
}

{$JARGLE_HOST} {
	import jargle_site
	header Strict-Transport-Security "max-age=31536000"
	log {
		output file /var/log/caddy/jargle.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}

# Optional local listener for a tunnel or reverse proxy.
http://:8080 {
	bind 127.0.0.1
	import jargle_site
	log {
		output file /var/log/caddy/jargle.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}

http://161.153.13.14 {
	redir https://{$JARGLE_HOST}{uri} 302
}
